load(":build_settings.bzl", "string_flag")

string_flag(
    name = "build_profile",
    build_setting_default = "debug",
    values = [
        "debug",
        "release",
        "profile",
        "shipping",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "build_profile_debug",
    flag_values = {
        ":build_profile": "debug",
    },
    visibility = ["//visibility:public"],
)

config_setting(
    name = "build_profile_release",
    flag_values = {
        ":build_profile": "release",
    },
    visibility = ["//visibility:public"],
)

