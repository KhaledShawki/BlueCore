load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")
load(
    "//build/bazel/rules:blue_cc_config.bzl",
    "BLUE_COPTS",
    "BLUE_RUNTIME_LINKOPTS",
    "blue_shared_consumer_deps",
    "blue_shared_dynamic_deps",
)
load("//build/bazel/rules:blue_cc_module.bzl", "blue_cc_module")

package(default_visibility = ["//visibility:private"])

BLUE_MEMORY_TEST_DEPS = [
    ":BlueMemory",
    "//modules/BlueSystem:BlueSystem",
    "@googletest//:gtest",
    "@googletest//:gtest_main",
] + blue_shared_consumer_deps(":BlueMemory_link_requirements")

BLUE_MEMORY_TEST_DYNAMIC_DEPS = blue_shared_dynamic_deps(":BlueMemory_shared")

blue_cc_module(
    name = "BlueMemory",
    srcs = [
        "src/AllocationFailure.cpp",
        "src/Allocator/SmallBlockAllocator.cpp",
        "src/AllocatorKind.cpp",
        "src/Backend/MemoryBackend.cpp",
        "src/Backend/MimallocMemoryBackend.cpp",
        "src/Backend/SystemMemoryBackend.cpp",
        "src/Config/BlueMemorySettings.cpp",
        "src/HeapAllocator.cpp",
        "src/Invoker/RuntimeAllocationInvoker.cpp",
        "src/LinearAllocator.cpp",
        "src/MemoryMetrics.cpp",
        "src/MemorySystem.cpp",
        "src/Metrics/MemoryThreadContext.cpp",
        "src/Oom/OomReporter.cpp",
        "src/Pch.cpp",
        "src/Pool/MemoryPoolRegistry.cpp",
        "src/PoolAllocator.cpp",
        "src/Proxy/RuntimeAllocationProxy.cpp",
        "src/Tracking/MemoryAllocationTracker.cpp",
        "src/VirtualMemoryBlock.cpp",
    ] + glob([
        "src/**/*.h",
    ]),
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.def",
    ]),
    configured_defines = select({
        "//build/bazel/settings:memory_backend_system": [
            "BLUE_MEMORY_USE_MIMALLOC=0",
        ],
        "//build/bazel/settings:memory_backend_mimalloc": [
            "BLUE_MEMORY_USE_MIMALLOC=1",
        ],
    }),
    defines = [
        "BLUE_MEMORY=1",
    ],
    deps = [
        "//modules/BlueSystem:BlueSystem",
    ] + select({
        "//build/bazel/settings:memory_backend_system": [],
        "//build/bazel/settings:memory_backend_mimalloc": [
            "//third_party:mimalloc",
        ],
    }),
    link_requirement_deps = [
        "//modules/BlueSystem:BlueSystem_link_requirements",
    ],
    linkopts = BLUE_RUNTIME_LINKOPTS,
    local_includes = ["src"],
    shared_dynamic_deps = [
        "//modules/BlueSystem:BlueSystem_shared",
    ],
    shared_local_defines = [
        "BLUE_BUILD_BLUE_MEMORY=1",
        "BLUE_EXPORT_BlueMemory=1",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "BlueMemoryHotPathBenchmarks",
    srcs = ["benchmarks/BlueMemoryHotPathBenchmarks.cpp"],
    copts = BLUE_COPTS,
    dynamic_deps = BLUE_MEMORY_TEST_DYNAMIC_DEPS,
    linkstatic = True,
    deps = [
        ":BlueMemory",
        "//modules/BlueSystem:BlueSystem",
        "//third_party/benchmark:benchmark",
    ] + blue_shared_consumer_deps(":BlueMemory_link_requirements"),
)

cc_test(
    name = "BlueMemoryBackendContractTests",
    srcs = ["tests/BlueMemoryBackendContractTests.cpp"],
    copts = BLUE_COPTS,
    dynamic_deps = BLUE_MEMORY_TEST_DYNAMIC_DEPS,
    linkstatic = True,
    size = "small",
    deps = BLUE_MEMORY_TEST_DEPS,
)

