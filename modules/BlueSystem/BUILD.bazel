load("@rules_cc//cc:defs.bzl", "cc_test")
load(
    "//build/bazel/rules:blue_cc_config.bzl",
    "BLUE_COPTS",
    "BLUE_SYSTEM_LINKOPTS",
    "blue_shared_consumer_deps",
    "blue_shared_dynamic_deps",
)
load("//build/bazel/rules:blue_cc_module.bzl", "blue_cc_module")

package(default_visibility = ["//visibility:private"])

BLUE_SYSTEM_TEST_DEPS = [
    ":BlueSystem",
    "@googletest//:gtest",
    "@googletest//:gtest_main",
] + blue_shared_consumer_deps(":BlueSystem_link_requirements")

BLUE_SYSTEM_TEST_DYNAMIC_DEPS = blue_shared_dynamic_deps(":BlueSystem_shared")

blue_cc_module(
    name = "BlueSystem",
    srcs = [
        "src/Assert.cpp",
        "src/Log/Logger.cpp",
        "src/Processor.cpp",
        "src/Result.cpp",
        "src/Time.cpp",
    ] + select({
        "@platforms//os:windows": [
            "src/Platform/Windows/Windows_Synchronization.h",
            "src/Platform/Windows/ConditionVariable_Windows.cpp",
            "src/Platform/Windows/Debug_Windows.cpp",
            "src/Platform/Windows/Event_Windows.cpp",
            "src/Platform/Windows/Mutex_Windows.cpp",
            "src/Platform/Windows/Processor_Windows.cpp",
            "src/Platform/Windows/Semaphore_Windows.cpp",
            "src/Platform/Windows/Thread_Windows.cpp",
        ],
        "@platforms//os:linux": [
            "src/Platform/Linux/Debug_Linux.cpp",
            "src/Platform/Linux/Processor_Linux.cpp",
            "src/Platform/Linux/Thread_Linux.cpp",
            "src/Platform/POSIX/POSIX_Synchronization.h",
            "src/Platform/POSIX/POSIX_Thread.h",
            "src/Platform/POSIX/ConditionVariable_POSIX.cpp",
            "src/Platform/POSIX/Event_POSIX.cpp",
            "src/Platform/POSIX/Mutex_POSIX.cpp",
            "src/Platform/POSIX/POSIX_Synchronization.cpp",
            "src/Platform/POSIX/Semaphore_POSIX.cpp",
            "src/Platform/POSIX/Thread_POSIX.cpp",
        ],
        "@platforms//os:osx": [
            "src/Platform/MacOS/Debug_MacOS.cpp",
            "src/Platform/MacOS/Processor_MacOS.cpp",
            "src/Platform/MacOS/Thread_MacOS.cpp",
            "src/Platform/POSIX/POSIX_Synchronization.h",
            "src/Platform/POSIX/POSIX_Thread.h",
            "src/Platform/POSIX/ConditionVariable_POSIX.cpp",
            "src/Platform/POSIX/Event_POSIX.cpp",
            "src/Platform/POSIX/Mutex_POSIX.cpp",
            "src/Platform/POSIX/POSIX_Synchronization.cpp",
            "src/Platform/POSIX/Semaphore_POSIX.cpp",
            "src/Platform/POSIX/Thread_POSIX.cpp",
        ],
        "//conditions:default": [],
    }),
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.inl",
    ]),
    defines = [
        "BLUE_SYSTEM=1",
    ],
    linkopts = BLUE_SYSTEM_LINKOPTS,
    shared_local_defines = [
        "BLUE_BUILD_BLUE_SYSTEM=1",
        "BLUE_EXPORT_BlueSystem=1",
    ],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "BlueSystemBaseContractTests",
    srcs = [
        "tests/BlueSystemBaseContractTests.cpp",
        "tests/BlueSystemTestWait.h",
    ],
    copts = BLUE_COPTS,
    dynamic_deps = BLUE_SYSTEM_TEST_DYNAMIC_DEPS,
    linkstatic = True,
    size = "small",
    deps = BLUE_SYSTEM_TEST_DEPS,
)

